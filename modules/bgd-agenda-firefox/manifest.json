{
  "manifest_version": 2,
  "name": "BrasilGuard Agenda",
  "version": "0.2.4",
  "description": "BrasilGuard Agenda v0003.d: agenda integrada ao Google Calendar com licenciamento comercial e operação offline-first governada.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "identity",
    "https://zwtmcqtepkzxuhilxyjx.supabase.co/*",
    "https://oauth2.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "browser_action": {
    "default_title": "Abrir BrasilGuard Agenda"
  },
  "background": {
    "scripts": ["config.js", "background.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "applications": {
    "gecko": {
      "id": "agenda@brasilguard.local",
      "strict_min_version": "109.0"
    }
  }
}

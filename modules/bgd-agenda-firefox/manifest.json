{
  "manifest_version": 2,
  "name": "BrasilGuard Agenda",
  "version": "0.1.1",
  "description": "Agenda BrasilGuard com login Google, agenda visual LIVRE/OCUPADO, RBAC, clientes, profissionais, serviços, branding e mensagens transacionais.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "identity",
    "https://*/"
  ],
  "browser_action": {
    "default_title": "Abrir BrasilGuard Agenda"
  },
  "background": {
    "scripts": ["config.js", "background.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "applications": {
    "gecko": {
      "id": "agenda@brasilguard.local",
      "strict_min_version": "109.0"
    }
  }
}

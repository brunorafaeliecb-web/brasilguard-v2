{
  "manifest_version": 2,
  "name": "BrasilGuard Agenda",
  "version": "0.2.0",
  "description": "BrasilGuard Agenda v0003.a: plataforma multi-tenant com agenda visual, RBAC, white-label, integrações, webhooks, pagamentos e base offline-first.",
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "identity",
    "https://*/"
  ],
  "browser_action": {
    "default_title": "Abrir BrasilGuard Agenda"
  },
  "background": {
    "scripts": ["config.js", "background.js"],
    "persistent": false
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "applications": {
    "gecko": {
      "id": "agenda@brasilguard.local",
      "strict_min_version": "109.0"
    }
  }
}
